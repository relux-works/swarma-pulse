    {
      "id": "parser-duplicate-key",
      "valid_neighbor": {
        "card": "converted-v4.json",
        "source_pins": "manifest.json#/source_pins",
        "operation": "parse-document",
        "expected": "accept",
        "semantic_validation": "not-in-this-stage",
        "expected_parsed_document": "converted-v4.json"
      },
      "counterexample": {
        "raw_transform": {
          "kind": "duplicate-json-object-key",
